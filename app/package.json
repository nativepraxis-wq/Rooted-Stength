{
  "name": "rooted-strength",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "claims": "node scripts/claims.mjs",
    "allergens": "node scripts/allergens.mjs",
    "headers": "node scripts/headers.mjs",
    "h1": "vite build --ssr scripts/h1-check.tsx --outDir .h1check --logLevel error && node .h1check/h1-check.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
